{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TrayBin",
  "version": "2.0.0",
  "identifier": "com.traurigerengel.traybin",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "panel",
        "title": "TrayBin",
        "width": 376,
        "height": 528,
        "minWidth": 376,
        "maxWidth": 376,
        "minHeight": 528,
        "maxHeight": 528,
        "resizable": false,
        "center": true,
        "visible": false,
        "decorations": false,
        "shadow": false,
        "transparent": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/empty.ico"
    ]
  }
}
